<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/CashSessionConcurrencyTest.php</exclude>
            <exclude>tests/Feature/InventoryConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LoyaltyConcurrencyTest.php</exclude>
            <exclude>tests/Feature/PublicLoyaltyConcurrencyTest.php</exclude>
            <exclude>tests/Feature/PurchaseReceiptConcurrencyTest.php</exclude>
            <exclude>tests/Feature/SaleFinalizationConcurrencyTest.php</exclude>
            <exclude>tests/Feature/SaleReturnConcurrencyTest.php</exclude>
            <exclude>tests/Feature/SupplierPaymentConcurrencyTest.php</exclude>
        </testsuite>
        <testsuite name="ZConcurrency">
            <file>tests/Feature/CashSessionConcurrencyTest.php</file>
            <file>tests/Feature/InventoryConcurrencyTest.php</file>
            <file>tests/Feature/LoyaltyConcurrencyTest.php</file>
            <file>tests/Feature/PublicLoyaltyConcurrencyTest.php</file>
            <file>tests/Feature/PurchaseReceiptConcurrencyTest.php</file>
            <file>tests/Feature/SaleFinalizationConcurrencyTest.php</file>
            <file>tests/Feature/SaleReturnConcurrencyTest.php</file>
            <file>tests/Feature/SupplierPaymentConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_DATABASE" value="mypos_test"/>
        <env name="DB_USERNAME" value="mypos_test"/>
        <env name="DB_PASSWORD" value="mypos_test_password"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
